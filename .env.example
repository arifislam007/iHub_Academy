# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# Frontend (leave empty in production: nginx serves the API on the same origin)
VITE_API_URL=http://localhost:3000

# Backend
POSTGRES_DB=skill_academy
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgres://admin:replace_with_a_strong_password@db:5432/skill_academy
# Must be at least 32 characters, or the admin endpoints stay disabled
ADMIN_KEY=replace_with_output_of_openssl_rand_hex_32
NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call the API cross-origin (local dev only).
# Leave empty in production.
ALLOWED_ORIGINS=http://localhost:5173
